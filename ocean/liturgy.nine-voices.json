  "応答": [
    {
      "名": "海が満ちたら、菌糸が応える",
      "時": { "信号": "presence:ocean", "演算": ">", "値": 0.5, "持続": 3 },
      "為": {
        "target": "mycorrhiza-beat", "command": "ramp",
